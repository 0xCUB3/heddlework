{
  "name": "pi-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.tsx",
    "start": "bun src/main.tsx",
    "demo": "PI_WORKBENCH_DEMO=1 bun --hot src/main.tsx",
    "typecheck": "tsc --noEmit",
