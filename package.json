{
  "name": "heddlework",
  "version": "0.1.0",
  "description": "A native, harness-neutral workspace for agent sessions, task graphs, diffs, and durable work.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/heddlework.git"
  },
  "bugs": {
    "url": "https://github.com/monotykamary/heddlework/issues"
  },
  "homepage": "https://github.com/monotykamary/heddlework#readme",
  "keywords": [
    "agentic-development",
    "coding-agent",
    "desktop-app",
    "gpuix",
    "pi"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.tsx",
    "start": "bun src/main.tsx",
    "demo": "HEDDLEWORK_DEMO=1 bun --watch src/main.tsx",
    "host": "bun src/host/main.ts",
    "release:tag": "bun scripts/release-tag.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p src/web",
    "test": "bun test",
    "check": "bun run typecheck && bun run typecheck:web && bun run test",
    "build:web": "bun scripts/build-web.ts",
    "dev:web": "bun scripts/dev-web.ts",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@gpuix/react": "0.6.0",
    "@mathjax/src": "4.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "."
  ]
}
