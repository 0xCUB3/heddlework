{
  "name": "heddlework",
  "version": "0.1.2-rc.1",
  "description": "A native, harness-neutral workspace for agent sessions, task graphs, diffs, and durable work.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/heddlework.git"
  },
  "bugs": {
    "url": "https://github.com/monotykamary/heddlework/issues"
  },
  "homepage": "https://github.com/monotykamary/heddlework#readme",
  "keywords": [
    "agentic-development",
    "coding-agent",
    "desktop-app",
    "gpuix",
    "pi"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.tsx",
    "start": "bun src/main.tsx",
    "demo": "HEDDLEWORK_DEMO=1 bun --watch src/main.tsx",
    "host": "bun src/host/main.ts",
    "release:tag": "bun scripts/release-tag.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p src/web",
    "test": "bun test",
    "check": "bun run typecheck && bun run typecheck:web && bun run test",
    "build:web": "bun scripts/build-web.ts",
    "dev:web": "bun scripts/dev-web.ts",
    "build": "bun scripts/build.ts",
    "install:dev": "bun scripts/install-dev.ts",
    "icons": "bun scripts/generate-icons.ts",
    "gpuix:fetch": "scripts/fetch-gpuix.sh",
    "gpuix:build": "scripts/build-gpuix.sh",
    "smoke:browser": "bun scripts/smoke-browser.ts",
    "benchmark:terminal": "bun scripts/benchmark-terminal.ts && bun scripts/benchmark-terminal-ui.tsx",
    "benchmark:terminal:hires": "bun scripts/benchmark-terminal-hires.ts",
    "benchmark:terminal:gpuix": "bun scripts/benchmark-terminal-gpuix.tsx",
    "benchmark:transcript": "bun scripts/benchmark-transcript.ts"
  },
  "dependencies": {
    "@gpuix/react": "file:vendor/gpuix/gpuix-react-0.7.0-heddlework.3.tgz",
    "@gpuix/native": "file:vendor/gpuix/gpuix-native-0.7.0-heddlework.3.tgz",
    "@mathjax/src": "4.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "happy-dom": "^20.14.0",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "."
  ],
  "overrides": {
    "@gpuix/native": "file:vendor/gpuix/gpuix-native-0.7.0-heddlework.3.tgz"
  }
}
