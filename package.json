{
  "name": "heddlework",
  "version": "0.1.0",
  "description": "A native, harness-neutral workspace for agent sessions, task graphs, diffs, and durable work.",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/heddlework.git"
  },
  "bugs": {
    "url": "https://github.com/monotykamary/heddlework/issues"
  },
  "homepage": "https://github.com/monotykamary/heddlework#readme",
  "keywords": [
    "agentic-development",
    "coding-agent",
    "desktop-app",
    "gpuix",
    "pi"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --hot src/main.tsx",
    "start": "bun src/main.tsx",
    "demo": "HEDDLEWORK_DEMO=1 bun --hot src/main.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "pnpm run typecheck && pnpm run test",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@gpuix/react": "0.5.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  }
}
