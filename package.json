    "check": "bun run typecheck && bun test",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@gpuix/react": "0.4.0",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
