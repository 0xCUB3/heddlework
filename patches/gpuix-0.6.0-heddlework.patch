diff --git a/packages/native/src/custom_elements/terminal.rs b/packages/native/src/custom_elements/terminal.rs
new file mode 100644
index 0000000..e5f13cd
--- /dev/null
+++ b/packages/native/src/custom_elements/terminal.rs
@@ -0,0 +1,338 @@
+use serde::Deserialize;
+
+use super::{CustomElement, CustomElementFactory, CustomRenderContext};
+
+pub struct TerminalFactory;
+
+impl CustomElementFactory for TerminalFactory {
+    fn element_type(&self) -> &str {
+        "terminal"
+    }
+
+    fn create(&self, _id: u64) -> Box<dyn CustomElement> {
+        Box::new(TerminalElement::default())
+    }
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct WireStyle {
+    color: String,
+    background_color: String,
+    font_family: String,
+    #[serde(default = "normal_weight")]
+    font_weight: f32,
+    #[serde(default)]
+    italic: bool,
+    #[serde(default)]
+    underline: bool,
+    #[serde(default)]
+    strike: bool,
+    #[serde(default)]
+    fill: bool,
+}
+
+fn normal_weight() -> f32 {
+    400.0
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct WireFrame {
+    cols: usize,
+    rows: usize,
+    cell_width: f32,
+    line_height: f32,
+    font_size: f32,
+    background: String,
+    cursor_color: String,
+    cursor_x: usize,
+    cursor_y: usize,
+    cursor_visible: bool,
+    styles: Vec<WireStyle>,
+    runs: Vec<(usize, usize, usize, usize, String)>,
+}
+
+#[derive(Clone, Debug)]
+struct PaintStyle {
+    color: gpui::Hsla,
+    background_color: gpui::Hsla,
+    font: gpui::Font,
+    underline: bool,
+    strike: bool,
+    fill: bool,
+}
+
+#[derive(Clone, Debug)]
+struct PaintRun {
+    row: usize,
+    column: usize,
+    columns: usize,
+    style: usize,
+    text: gpui::SharedString,
+}
+
+#[derive(Clone, Debug)]
+struct TerminalFrame {
+    cols: usize,
+    rows: usize,
+    cell_width: f32,
+    line_height: f32,
+    font_size: f32,
+    background: gpui::Hsla,
+    cursor_color: gpui::Hsla,
+    cursor_x: usize,
+    cursor_y: usize,
+    cursor_visible: bool,
+    styles: Vec<PaintStyle>,
+    runs: Vec<PaintRun>,
+}
+
+impl TerminalFrame {
+    fn from_wire(frame: WireFrame) -> Self {
+        let background = parse_color(&frame.background, gpui::transparent_black());
+        let styles = frame
+            .styles
+            .into_iter()
+            .map(|style| {
+                let color = parse_color(&style.color, gpui::white());
+                let mut font = gpui::font(style.font_family);
+                font.weight = gpui::FontWeight(style.font_weight.clamp(100.0, 900.0));
+                font.style = if style.italic {
+                    gpui::FontStyle::Italic
+                } else {
+                    gpui::FontStyle::Normal
+                };
+                PaintStyle {
+                    color,
+                    background_color: parse_color(&style.background_color, background),
+                    font,
+                    underline: style.underline,
+                    strike: style.strike,
+                    fill: style.fill,
+                }
+            })
+            .collect();
+        let runs = frame
+            .runs
+            .into_iter()
+            .map(|(row, column, columns, style, text)| PaintRun {
+                row,
+                column,
+                columns,
+                style,
+                text: text.into(),
+            })
+            .collect();
+        Self {
+            cols: frame.cols,
+            rows: frame.rows,
+            cell_width: frame.cell_width.max(1.0),
+            line_height: frame.line_height.max(1.0),
+            font_size: frame.font_size.max(1.0),
+            background,
+            cursor_color: parse_color(&frame.cursor_color, gpui::white()),
+            cursor_x: frame.cursor_x,
+            cursor_y: frame.cursor_y,
+            cursor_visible: frame.cursor_visible,
+            styles,
+            runs,
+        }
+    }
+}
+
+fn parse_color(value: &str, fallback: gpui::Hsla) -> gpui::Hsla {
+    crate::color::parse_color_rgba(value)
+        .map(Into::into)
+        .unwrap_or(fallback)
+}
+
+#[derive(Clone)]
+struct ShapedRun {
+    line: gpui::ShapedLine,
+    x: f32,
+    y: f32,
+}
+
+#[derive(Clone)]
+struct PaintRect {
+    x: f32,
+    y: f32,
+    width: f32,
+    height: f32,
+    color: gpui::Hsla,
+}
+
+struct PaintState {
+    frame: TerminalFrame,
+    text: Vec<ShapedRun>,
+    rects: Vec<PaintRect>,
+}
+
+#[derive(Default)]
+pub struct TerminalElement {
+    frame: Option<TerminalFrame>,
+}
+
+impl CustomElement for TerminalElement {
+    fn render(
+        &mut self,
+        ctx: CustomRenderContext,
+        _window: &mut gpui::Window,
+        _cx: &mut gpui::Context<crate::renderer::GpuixView>,
+    ) -> gpui::AnyElement {
+        use gpui::prelude::*;
+
+        let Some(frame) = self.frame.clone() else {
+            let empty = super::custom_surface(
+                gpui::div().id(gpui::SharedString::from(format!("__gpuix_terminal_{}", ctx.id))),
+                &ctx,
+            );
+            return empty.into_any_element();
+        };
+
+        let canvas = gpui::canvas(
+            move |_bounds, window, _cx| {
+                let mut text = Vec::with_capacity(frame.runs.len());
+                let mut rects = Vec::new();
+                for run in &frame.runs {
+                    if run.row >= frame.rows || run.column >= frame.cols || run.columns == 0 {
+                        continue;
+                    }
+                    let Some(style) = frame.styles.get(run.style) else {
+                        continue;
+                    };
+                    let x = run.column as f32 * frame.cell_width;
+                    let y = run.row as f32 * frame.line_height;
+                    let width = run.columns.min(frame.cols - run.column) as f32 * frame.cell_width;
+                    if style.fill || style.background_color != frame.background {
+                        rects.push(PaintRect {
+                            x,
+                            y,
+                            width,
+                            height: frame.line_height,
+                            color: if style.fill { style.color } else { style.background_color },
+                        });
+                    }
+                    if style.fill
+                        || run.text.is_empty()
+                        || (run.text.chars().all(char::is_whitespace)
+                            && !style.underline
+                            && !style.strike)
+                        || (style.color == style.background_color
+                            && !style.underline
+                            && !style.strike)
+                    {
+                        continue;
+                    }
+                    let text_run = gpui::TextRun {
+                        len: run.text.len(),
+                        font: style.font.clone(),
+                        color: style.color,
+                        background_color: None,
+                        underline: style.underline.then_some(gpui::UnderlineStyle {
+                            thickness: gpui::px(1.0),
+                            color: Some(style.color),
+                            wavy: false,
+                        }),
+                        strikethrough: style.strike.then_some(gpui::StrikethroughStyle {
+                            thickness: gpui::px(1.0),
+                            color: Some(style.color),
+                        }),
+                    };
+                    let line = window.text_system().shape_line(
+                        run.text.clone(),
+                        gpui::px(frame.font_size),
+                        &[text_run],
+                        Some(gpui::px(frame.cell_width)),
+                    );
+                    text.push(ShapedRun { line, x, y });
+                }
+                PaintState {
+                    frame,
+                    text,
+                    rects,
+                }
+            },
+            move |bounds, state, window, cx| {
+                window.paint_quad(gpui::fill(bounds, state.frame.background));
+                for rect in state.rects {
+                    window.paint_quad(gpui::fill(
+                        gpui::Bounds::new(
+                            gpui::point(
+                                bounds.origin.x + gpui::px(rect.x),
+                                bounds.origin.y + gpui::px(rect.y),
+                            ),
+                            gpui::size(gpui::px(rect.width), gpui::px(rect.height)),
+                        ),
+                        rect.color,
+                    ));
+                }
+                for run in state.text {
+                    crate::text::paint::log_painted_text(run.line.text.clone());
+                    let _ = run.line.paint(
+                        gpui::point(
+                            bounds.origin.x + gpui::px(run.x),
+                            bounds.origin.y + gpui::px(run.y),
+                        ),
+                        gpui::px(state.frame.line_height),
+                        gpui::TextAlign::Left,
+                        None,
+                        window,
+                        cx,
+                    );
+                }
+                if state.frame.cursor_visible
+                    && state.frame.cursor_x < state.frame.cols
+                    && state.frame.cursor_y < state.frame.rows
+                {
+                    window.paint_quad(gpui::fill(
+                        gpui::Bounds::new(
+                            gpui::point(
+                                bounds.origin.x
+                                    + gpui::px(state.frame.cursor_x as f32 * state.frame.cell_width),
+                                bounds.origin.y
+                                    + gpui::px(state.frame.cursor_y as f32 * state.frame.line_height),
+                            ),
+                            gpui::size(
+                                gpui::px(state.frame.cell_width),
+                                gpui::px(state.frame.line_height),
+                            ),
+                        ),
+                        state.frame.cursor_color.opacity(0.35),
+                    ));
+                }
+            },
+        )
+        .absolute()
+        .size_full();
+
+        let surface = super::custom_surface(
+            gpui::div()
+                .id(gpui::SharedString::from(format!("__gpuix_terminal_{}", ctx.id)))
+                .overflow_hidden(),
+            &ctx,
+        );
+        surface.child(canvas).into_any_element()
+    }
+
+    fn set_prop(&mut self, key: &str, value: serde_json::Value) {
+        if key == "frame" {
+            self.frame = serde_json::from_value::<WireFrame>(value)
+                .ok()
+                .map(TerminalFrame::from_wire);
+        }
+    }
+
+    fn supported_props(&self) -> &'static [&'static str] {
+        &["frame"]
+    }
+
+    fn supported_events(&self) -> &'static [&'static str] {
+        &[]
+    }
+
+    fn destroy(&mut self) {
+        self.frame = None;
+    }
+}
